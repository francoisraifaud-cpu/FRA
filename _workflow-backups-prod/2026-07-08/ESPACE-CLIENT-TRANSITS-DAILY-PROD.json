        }
      },
      "id": "n-schedule",
      "name": "Schedule Daily",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        128
      ]
    },
    {
      "parameters": {
        "jsCode": "// Lit la date (dd/MM/yyyy) du déclencheur ou tombe sur aujourd'hui (UTC).\nconst j = $input.first().json || {};\nconst body = j.body && typeof j.body === 'object' && !Array.isArray(j.body) ? j.body : j;\nfunction pad(n){return String(n).padStart(2,'0');}\nlet dmy = body.date;\nif (!/^\\d{2}\\/\\d{2}\\/\\d{4}$/.test(dmy || '')) {\n  const d = new Date();\n  dmy = pad(d.getUTCDate()) + '/' + pad(d.getUTCMonth()+1) + '/' + d.getUTCFullYear();\n}\nconst [dd, mm, yyyy] = dmy.split('/');\nreturn [{ json: { dmy, iso: yyyy + '-' + mm + '-' + dd } }];"
      },
      "id": "n-prepare",
      "name": "Prepare Date",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ]
    },
    {
      "parameters": {
        "url": "=https://api.spikka.eu/transits?date_debut={{ $('Prepare Date').first().json.dmy }}&date_fin={{ $('Prepare Date').first().json.dmy }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "__REDACTED__"
            }
          ]
        }
      },
      "id": "n-transits",
      "name": "HTTP Transits",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        448,
        0
      ]
    },
    {
      "parameters": {
        "url": "=https://api.spikka.eu/moon?date_debut={{ $('Prepare Date').first().json.dmy }}&date_fin={{ $('Prepare Date').first().json.dmy }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "__REDACTED__"
            }
          ]
        }
      },
      "id": "n-moon",
      "name": "HTTP Moon",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        672,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Normalise transits + lune vers { date, planets[] } attendu par le site.\nconst prep = $('Prepare Date').first().json;\nconst norm360 = (a) => ((a % 360) + 360) % 360;\n\nconst trItems = $('HTTP Transits').all().map(i => i.json);\nconst trRow = trItems.find(r => r && r.planetes) || trItems[0] || {};\nconst P = (trRow && trRow.planetes) ? trRow.planetes : {};\n\nconst moonItems = $('HTTP Moon').all().map(i => i.json);\nconst moonRow = moonItems.find(r => r && typeof r.date_heure === 'string' && r.date_heure.includes('12:00'))\n  || moonItems[moonItems.length - 1] || null;\n\n// 10 classiques + Chiron + Nœuds (décision produit 2026-06).\nconst NAME_MAP = {\n  Soleil: 'Soleil', Mercure: 'Mercure', 'Vénus': 'Vénus', Mars: 'Mars',\n  Jupiter: 'Jupiter', Saturne: 'Saturne', Uranus: 'Uranus', Neptune: 'Neptune',\n  Pluton: 'Pluton', Chiron: 'Chiron', Noeud_Nord: 'Nœud Nord', Noeud_Sud: 'Nœud Sud',\n};\nconst planets = [];\nfor (const src of Object.keys(NAME_MAP)) {\n  const p = P[src];\n  if (!p) continue;\n  const full = Number(p.longitude_absolue);\n  if (!Number.isFinite(full)) continue;\n  const nd = Number(p.degre_dans_signe);\n  planets.push({\n    name: NAME_MAP[src],\n    fullDegree: norm360(full),\n    normDegree: Number.isFinite(nd) ? nd : ((full % 30) + 30) % 30,\n    retro: p.est_retrograde === true,\n    sign: typeof p.signe === 'string' ? p.signe : undefined,\n  });\n}\nif (moonRow && moonRow.lune) {\n  const m = moonRow.lune;\n  const full = Number(m.longitude_absolue);\n  if (Number.isFinite(full)) {\n    const nd = Number(m.degre_dans_signe);\n    planets.push({\n      name: 'Lune',\n      fullDegree: norm360(full),\n      normDegree: Number.isFinite(nd) ? nd : ((full % 30) + 30) % 30,\n      retro: false,\n      sign: typeof m.signe === 'string' ? m.signe : undefined,\n    });\n  }\n}\nreturn [{ json: { date: prep.iso, planets, n8nExecutionId: String($execution.id) } }];"
      },
