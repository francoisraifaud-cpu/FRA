function esc(t) { return String(t).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

function inline(t) {
  const escaped = esc(t);
  return escaped
    .replace(/\*\*\*(.*?)\*\*\*/g, '<strong><em>$1</em></strong>')
    .replace(/\*\*(.*?)\*\*/g, '<strong style="color:var(--primary);font-weight:700;background:rgba(255,166,246,0.18);padding:0 3px;border-radius:3px;">$1</strong>')
    .replace(/\*(.*?)\*/g, '<em>$1</em>');
}

// Retire les parenthèses explicatives en fin de titre numéroté (ex : "3. Le ciment du temps (Longévité)" → "3. Le ciment du temps").
function _stripHeadingParens(t) {
  return String(t || '').replace(
    /^([ \t]*[#*]{0,3}[ \t]*\d[\d.]*[.)][ \t]+[^\n(]+?)[ \t]*\([^\n)]*\)([ \t]*[#*]{0,3}[ \t]*)$/gm,
    '$1$2'
  );
}

// Nettoyage du texte LLM de synthèse, identique aux 3 rapports :
//  - renomme « Verdict final + Bande qualitative » en libellé client clair
//  - SUPPRIME toute ligne d'harmonie globale émise par le LLM (« Note globale d'harmonie : XX/100 — … »)
//    car elle est désormais rendue de façon DÉTERMINISTE depuis les données moteur (cf. _harmonyVerdict()).
function _cleanSynRaw(t, en) {
  return _stripHeadingParens(String(t || ''))
    .replace(/Verdict final\s*\+\s*Bande qualitative|Final verdict\s*\+\s*Qualitative band/gi, en ? 'In summary' : 'En résumé')
    .replace(/^.*Note globale d['’]?harmonie.*$/gim, '')
    .replace(/^.*Overall harmony score.*$/gim, '');
}

// Verdict d'harmonie DÉTERMINISTE — construit depuis les données moteur (jamais le LLM).
// Même phrase et même police que le bloc de clôture du rapport final (style mantra THEME).
//   score = indice Harmonie du tableau de bord (= global_score_detail.harmony)
//   bande = global_score_detail.qualitative_band
// Rendu UNIQUEMENT si les deux sont présents (sinon rien : pas de phrase bancale).
function _harmonyVerdict() {
    if (!(globalScore > 0)) return '';
    const qb = globalScoreDetail?.qualitative_band || {};
    const band = isEN ? (qb.band_en || qb.band) : (qb.band || qb.band_en);
    const desc = isEN ? (qb.desc_en || qb.desc) : (qb.desc || qb.desc_en);
    if (!band) return '';
    // v7.4.1 — le LIBELLÉ de bande occupe la police « repère » (majuscules
    // interlettrées, IDENTIQUE au libellé au-dessus des 8 axes) ; la description
    // suit en texte courant. Plus de note chiffrée (cf. audit fiabilité).
    return '<div class="syn-verdict" style="background:rgba(255,166,246,0.20);border:1.5px solid rgba(255,166,246,0.6);border-radius:20px;padding:1.5rem 2.2rem;margin:0 0 1.8rem;text-align:center;-webkit-print-color-adjust:exact;print-color-adjust:exact;break-inside:avoid;page-break-inside:avoid;">'
        + '<div style="font-size:11px;letter-spacing:2.5px;text-transform:uppercase;color:var(--ink-soft);font-weight:700;margin-bottom:9px">' + esc(band) + '</div>'
        + '<p style="font-family:var(--font-body);font-weight:600;font-size:19px;line-height:1.6;color:var(--primary);font-style:italic;text-align:center;max-width:84%;margin:0 auto;">'
        + (desc ? esc(desc) : '')
        + '</p></div>';
}

function md(text, isEN) {
  if (!text || (typeof text === 'string' && text.trim() === ''))
    return '<p style="color: #aaa; font-style: italic; font-size: 14px;">' + (isEN ? 'Awaiting generation...' : 'En attente de génération...') + '</p>';
  text = String(text)
    // Conseils en liste NUMÉROTÉE avec amorce grasse (« 1. **Titre :** corps ») ->
    // convertis en PUCES, pour un rendu identique aux typologies qui sortent déjà
    // des puces (biz/pe) : amorce grasse rose inline + corps, sans gros sous-titre.
    .replace(/^(\s*)\d+[.)]\s+(\*\*)/gm, '$1- $2')
    // Rejoint un titre numéroté dont un fragment gras a été wrappé sur la ligne
    // suivante — MAIS jamais quand la ligne suivante est elle-même un nouvel item
    // numéroté « N. **… » (sinon on fusionne deux conseils -> le 2e disparaît).
    .replace(/^([\*]{0,3}\d[\d.]*[\.\)]\s[^\n]{4,})\n((?!\s*\d+[.)]\s)[^\n\*]{3,80}[\*]{1,3})/gm, '$1 $2');
  text = text.replace(/^([\*]{0,3}\d[\d.]*[\.\)]\s[^\n]*\([^\n)]*)\n([\wÀ-ÿ\u2019\u2018'-]+\))/gm, '$1 $2');
  text = text.replace(/^([\*]{0,3}\d[\d.]*[\.\)]\s[^\n]{30,140})\n([^\n\d\*\#\.]{2,25})\n/gm, '$1 $2\n');
  text = text.replace(/^(#{1,3} .+?)\s+#{2,}\s+([^\n]+)$/gm, '$1\n$2');
  const lines = text.split('\n');
  const out = [];
  let inList = false;
  for (let line of lines) {
    const isBullet = /^[-*]\s+\S/.test(line) && !/^\*\*/.test(line);
    if (!isBullet && inList) { out.push('</ul>'); inList = false; }
    line = line.replace(/\s+#+\s*$/, '');
    const stripped = line.replace(/\*/g, '');
    let lineHandled = false;
    if (/^#{1,2} /.test(line)) {
      line = '### ' + line.replace(/^#{1,2} /, '').replace(/\*/g, '');
    } else if (/^#{3,} /.test(line)) {
      line = '#### ' + line.replace(/^#{3,} /, '').replace(/\*/g, '');
    } else {
      const subMatch = stripped.match(/^(\d+\.\d+[.)]\s+)(.+)$/);
      if (subMatch) {
        const prefix = subMatch[1], rest = subMatch[2];
        const colon = rest.indexOf(' : ');
        if (colon > 0 && colon <= 90) {
          const after = rest.slice(colon + 3);
          if (after.length > 60) {
            out.push(`<h5 class="tk-subtitle">${esc(prefix + rest.slice(0, colon))}</h5>`);
            if (after.trim()) out.push(`<p class="sk-p">${inline(after)}</p>`);
            lineHandled = true;
          } else if ((prefix + rest).length <= 130) { line = '#### ' + prefix + rest; }
        } else if ((prefix + rest).length <= 130) { line = '#### ' + prefix + rest; }
      } else {
        const mainMatch = stripped.match(/^(\d+[.)]\s+)(.+)$/);
        if (mainMatch) {
          const prefix = mainMatch[1], rest = mainMatch[2];
          if ((prefix + rest).length <= 155) { line = '### ' + prefix + rest; }
          else {
            const colon = rest.indexOf(' : ');
            if (colon > 0 && colon <= 120) {
              const after = rest.slice(colon + 3);
              out.push(`<h4 class="tk-title"><span class="tk-title-ico">✦</span><span>${esc(prefix + rest.slice(0, colon))}</span></h4>`);
              if (after.trim()) out.push(`<p class="sk-p">${inline(after)}</p>`);
              lineHandled = true;
            } else { line = '### ' + prefix + rest; }
          }
        } else if (/^\*{2,3}[^*]{4,120}\*{2,3}$/.test(line)) { line = '### ' + stripped; }
        else if (/^(conclusion|synthèse|en\s+synthèse|en\s+conclusion|recommandation)/i.test(stripped) && stripped.length < 120) { line = '### ' + stripped; }
      }
    }
    if (lineHandled) continue;
    if (line.startsWith('### ')) {
      out.push(`<h4 class="tk-title"><span class="tk-title-ico">✦</span><span>${esc(line.replace(/^### /, ''))}</span></h4>`);
    } else if (line.startsWith('#### ')) {
      out.push(`<h5 class="tk-subtitle">${esc(line.replace(/^#### /, ''))}</h5>`);
    } else if (isBullet) {
      if (!inList) { out.push('<ul class="sk-ul">'); inList = true; }
      out.push(`<li>${inline(line.replace(/^[-*]\s+/, ''))}</li>`);
    } else if (line.trim() === '') {
      out.push('<div style="height:10px;"></div>');
    } else if (line.match(/^---+$/) || line.match(/^\*\*\*+$/)) {
      out.push('<hr class="sk-hr">');
    } else {
      out.push(`<p class="sk-p">${inline(line)}</p>`);
    }
  }
  if (inList) out.push('</ul>');
  return out.join('');
}

