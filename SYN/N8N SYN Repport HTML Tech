        svgLines += `<line x1="${t1.x.toFixed(1)}" y1="${t1.y.toFixed(1)}" x2="${t2.x.toFixed(1)}" y2="${t2.y.toFixed(1)}" stroke="${col}" stroke-width="${lw}" opacity="0.8"/>`;
        const off = Math.abs(angDiff(p.displayA, p.trueA));
        if (off > 1.5) {
            const g = pol(e2s(p.displayA), glyphR);
            svgLines += `<line x1="${t2.x.toFixed(1)}" y1="${t2.y.toFixed(1)}" x2="${g.x.toFixed(1)}" y2="${g.y.toFixed(1)}" stroke="${col}" stroke-width="0.8" opacity="0.6"/>`;
        }
