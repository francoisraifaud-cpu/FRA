function buildSynTechTocHtml() {
    const navAria = isEN ? "Table of contents" : "Sommaire";
    const title = isEN ? "Contents" : "Sommaire";
    const rows = [];
    if (_cdcTech.present) rows.push({ id: "syn-tech-carte-ciel", lab: isEN ? "The sky chart" : "Carte du ciel", sub: isEN ? "Your two skies superimposed" : "Vos deux ciels superposés" });
    if (globalScore > 0) {
        rows.push({ id: "syn-tech-score", lab: isEN ? "Relationship dashboard" : "Tableau de bord relationnel", sub: isEN ? "8 indices of the bond" : "8 indices du lien" });
    }
    if (synthese && String(synthese.llm_text || "").trim()) {
        rows.push({ id: "syn-tech-synthese", lab: isEN ? "Relationship synthesis" : "Synthèse relationnelle", sub: isEN ? "The overall reading of your bond" : "La lecture d'ensemble de votre lien" });
    }
    const _hName = (h) => { const t = (MAISONS_SYN[h] || {}).titre || ('M' + h); return String(t).replace(/^(Maison|House)\s*\d+\s*[—-]\s*/, '') || ('M' + h); };
    const housesAItems = synTocHousesA.map((h) => `<li><a href="#syn-tech-a-${h}"><span class="sk-toc-hnum">${h}</span><span class="sk-toc-hname">${esc(_hName(h))}</span></a></li>`).join("");
    rows.push({ id: "syn-tech-perspective-a", lab: isEN ? `${persoA}'s astrological houses` : `Maisons astrologiques de ${persoA}`, sub: isEN ? `Impact of ${persoB}` : `Impact de ${persoB}`, houses: housesAItems });
    const housesBItems = synTocHousesB.map((h) => `<li><a href="#syn-tech-b-${h}"><span class="sk-toc-hnum">${h}</span><span class="sk-toc-hname">${esc(_hName(h))}</span></a></li>`).join("");
    rows.push({ id: "syn-tech-perspective-b", lab: isEN ? `${persoB}'s astrological houses` : `Maisons astrologiques de ${persoB}`, sub: isEN ? `Impact of ${persoA}` : `Impact de ${persoA}`, houses: housesBItems });
    if (!rows.length) return "";
    const items = rows.map((r) => {
        const sublist = r.houses ? `<ul class="sk-toc-houses">${r.houses}</ul>` : '';
        return `<li><a href="#${r.id}" class="sk-toc-a"><span class="sk-toc-num">${_synTechNo[r.id] || ''}</span><span class="sk-toc-txt"><span class="sk-toc-lab">${esc(r.lab)}</span>${r.sub ? `<span class="sk-toc-sub">${esc(r.sub)}</span>` : ''}</span></a>${sublist}</li>`;
    }).join("");
    return `<div class="sk-toc-hero"><nav class="syn-tech-toc sk-toc" id="syn-tech-sommaire-nav" aria-label="${esc(navAria)}">
<h2 class="sk-toc-title">${esc(title)}</h2>
<ul class="sk-toc-ul">${items}</ul>
</nav></div>`;
}

// ════════════════════════════════════════════════════════════════════════
// COMPOSANT PARTAGÉ — Tableau de bord relationnel (8 indices /100)
// Rendu STRICTEMENT IDENTIQUE dans les 3 rapports (Final, Tech, Données Tech).
// Toutes les chaînes proviennent de l'objet moteur `relationship_dashboard`.
// Toute modification doit être répliquée à l'identique dans les 3 fichiers.
// ════════════════════════════════════════════════════════════════════════
function buildSynDashboard(dashObj, en, band, secNo) {
    if (!dashObj || !dashObj.metrics || !dashObj.groups) return '';
    const M = dashObj.metrics, L = dashObj.labels || {};
    const t = (o, f) => o ? (en ? (o.en || o.fr) : (o.fr || o.en)) : (f || '');
    const bar = (key) => {
        const m = M[key];
        if (!m) return '';
        let nm = en ? (m.name_en || m.name) : m.name;
        if (key === 'fluidite') nm = en ? 'Harmony' : 'Harmonie';
        const bandTxt = en ? (m.label_en || m.label) : m.label;
        const desc = en ? (m.desc_en || m.desc || '') : (m.desc || m.desc_en || '');
        const score = Math.max(0, Math.min(100, Math.round(m.score || 0)));
        const dir = (key === 'karmique' && (en ? m.direction_en : m.direction)) ? ' \u00b7 ' + (en ? m.direction_en : m.direction) : '';
        // Couleurs harmonisées charte SPIKKA (violet/rose) — identique au rapport final.
        return '<div style="margin:7px 0;text-align:left">'
            + '<div style="display:flex;justify-content:space-between;align-items:baseline;font-size:0.85em;margin-bottom:2px">'
            + '<span style="color:var(--primary);font-weight:600">' + (m.icon ? m.icon + '\u00a0' : '') + nm + '</span>'
            + '<span style="color:var(--primary);font-weight:700">' + score + '<span style="font-size:0.72em;color:var(--ink-soft)">/100</span> <span style="font-size:0.82em;font-weight:600;color:var(--ink-soft)">' + bandTxt + dir + '</span></span>'
            + '</div>'
            + '<div style="height:9px;background:rgba(46,21,96,0.10);border-radius:6px;overflow:hidden;-webkit-print-color-adjust:exact;print-color-adjust:exact;"><div style="height:100%;width:' + score + '%;background:linear-gradient(90deg,var(--primary),var(--accent));border-radius:6px;-webkit-print-color-adjust:exact;print-color-adjust:exact;"></div></div>'
            + (desc ? '<div style="font-size:0.7em;color:var(--ink-soft);margin-top:3px;line-height:1.35">' + desc + '</div>' : '')
            + '</div>';
    };
    const grp = (gkey) => {
        const lab = L[gkey] || {};
        const title = en ? (lab.en || lab.fr || '') : (lab.fr || lab.en || '');
        const hint = en ? (lab.hint_en || '') : (lab.hint_fr || '');
        return '<div style="flex:1;min-width:250px;text-align:left">'
            + '<div style="font-family:var(--font-title);font-size:1.05em;color:var(--primary);font-weight:400;border-bottom:1px solid var(--line);padding-bottom:6px;margin-bottom:2px">' + title + '</div>'
            + (hint ? '<div style="font-size:0.7em;color:var(--ink-soft);font-style:italic;margin-bottom:6px">' + hint + '</div>' : '')
            + (dashObj.groups[gkey] || []).map(bar).join('')
            + '</div>';
    };
    const bandTop = band && (en ? (band.band_en || band.band) : band.band);
    const qbLine = bandTop ? '<div style="text-align:center;font-size:11px;letter-spacing:2.5px;text-transform:uppercase;font-weight:700;color:var(--ink-soft);margin:2px 0 16px">' + bandTop + '</div>' : '';
    const header = skSection(secNo || '', t(dashObj.title, en ? 'Relationship Dashboard' : 'Tableau de bord relationnel'), en ? 'Eight indices of the bond, scored 0 to 100' : 'Huit indices du lien, notés de 0 à 100');
    return '<div class="keep-together" style="margin:0 0 24px;page-break-before:always;break-before:page;page-break-inside:avoid;break-inside:avoid">'
        + header
        + '<div class="syn-dashboard" style="margin:0;padding:18px 22px;background:#fff;border:1px solid var(--line);border-radius:var(--radius);-webkit-print-color-adjust:exact;print-color-adjust:exact;">'
        + qbLine
        + '<div style="display:flex;gap:28px;flex-wrap:wrap">' + grp('lien') + grp('domaines') + '</div>'
        + (t(dashObj.note) ? '<div style="margin-top:14px;font-size:0.72em;color:var(--ink-soft);font-style:italic;line-height:1.5;text-align:center;max-width:560px;margin-left:auto;margin-right:auto">' + t(dashObj.note) + '</div>' : '')
        + '</div>'
        + '</div>';
}

