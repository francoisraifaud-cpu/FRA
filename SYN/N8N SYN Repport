// ── i18n EN : passe finale de traduction des NOMS PROPRES astro (signes / planètes /
// angles / aspects / éléments) dans les valeurs de données. Le générateur traduit déjà
// les LABELS via isEN ; ici on couvre les valeurs FR injectées par le moteur (ex.
// big3, dignités, dispositeurs, maisons, aspects signature, matrice). Vocabulaire fini
// et distinctif, remplacement en mots entiers, composés (« Nœud Nord ») avant simples.
if (isEN) {
    const _frEnPairs = [];
    for (const s of SIGN_LEGEND)   _frEnPairs.push([s.fr, s.en]);
    for (const p of PLANET_LEGEND) _frEnPairs.push([p.fr, p.en]);
    for (const a of ANGLE_LEGEND)  _frEnPairs.push([a.fr, a.en]);
    // Aspects (non couverts par les tables LEGEND)
    for (const pr of [['Conjonction','Conjunction'],['Trigone','Trine'],['Carré','Square'],
        ['Quinconce','Quincunx'],['Semi-carré','Semi-square'],['Sesqui-carré','Sesquiquadrate'],
        ['Semi-sextile','Semi-sextile'],['Quintile','Quintile'],['Bi-quintile','Bi-quintile']]) _frEnPairs.push(pr);
    // Éléments / modes / secte / natures de contact résiduels
    for (const pr of [['Feu','Fire'],['Terre','Earth'],['Eau','Water'],['Fixe','Fixed'],
        ['Diurne','Diurnal'],['Nocturne','Nocturnal'],['harmonie','harmony'],['ajustement','adjustment']]) _frEnPairs.push(pr);
    // Prose technique des détails de dignité accidentelle (Lilly) + conditions Hayz (moteur, FR-only).
    for (const pr of [
        ['Aspect(s) bénéfique(s) reçu(s)','Benefic aspect(s) received'],['Aspect(s) maléfique(s) reçu(s)','Malefic aspect(s) received'],
        ['secte correcte (diurne de jour)','correct sect (diurnal by day)'],['secte correcte (nocturne de nuit)','correct sect (nocturnal by night)'],
        ['planète nocturne de jour','nocturnal planet by day'],['planète diurne de nuit','diurnal planet by night'],
        ['nocturne de jour','nocturnal by day'],['diurne de nuit','diurnal by night'],
        ['diurne de jour','diurnal by day'],['nocturne de nuit','nocturnal by night'],
        ['au-dessus horizon','above horizon'],['au-dessous horizon','below horizon'],['sous horizon','below horizon'],['planète','planet'],
        ['signe masculin','masculine sign'],['signe féminin','feminine sign'],['secte correcte','correct sect'],
        ['Vitesse rapide','Fast speed'],['Vitesse lente','Slow speed'],['Sous les rayons','Under the beams'],
        ['HAYZ parfait','Perfect HAYZ'],['HAYZ partiel','Partial HAYZ'],['Hayz parfait','Perfect Hayz'],['Hayz partiel','Partial Hayz'],
        ['cadente faible','weak cadent'],['Libre du','Free from'],['Libre de','Free from'],['Joie de','Joy of'],
        ['angulaire','angular'],['succédente','succedent'],['cadente','cadent'],['Rétrograde','Retrograde'],
        ['Occidental','Western'],['Oriental','Eastern'],['inférieure','inferior'],['supérieure','superior'],
        ['Combuste','Combust'],['Exil','Detriment'],['Chute','Fall']]) _frEnPairs.push(pr);
    // Lots arabes (noms composés — avant les noms simples grâce au tri par longueur)
    for (const pr of [['Lot de la Mère','Lot of the Mother'],['Lot du Père','Lot of the Father'],
        ['Part de Fortune','Part of Fortune'],['Lot de Fortune','Lot of Fortune'],['Lot de l\'Esprit','Lot of Spirit'],
        ['Lot du Mariage','Lot of Marriage'],['Lot d\'Éros','Lot of Eros'],['Lot de Nécessité','Lot of Necessity'],
        ['Lot de Courage','Lot of Courage'],['Lot de Némésis','Lot of Nemesis'],['Lot de Basis','Lot of Basis'],
        ['Lot d\'Exaltation','Lot of Exaltation'],['Lot du Daemon','Lot of the Daemon'],['Lot des Enfants','Lot of Children'],
        ['Lot de Victoire','Lot of Victory'],['Lot de Voyage','Lot of Travel'],['Lot de Maladie','Lot of Illness']]) _frEnPairs.push(pr);
    // Prose moteur à variantes finies (note de compatibilité des termes lunaires — supernode SYN).
    // Segments fixes traduits ; les parties dynamiques « (terme) » restent gérées par la passe noms propres.
    for (const pr of [
        ['Les Lunes partagent le même maître de terme','The Moons share the same term ruler'],
        ['une affinité émotionnelle profonde et inconsciente','a deep and unconscious emotional affinity'],
        ['Les maîtres de terme lunaires','The lunar term rulers'],
        ['sont en réception mutuelle — un échange émotionnel subtil et complémentaire','are in mutual reception — a subtle and complementary emotional exchange'],
        ["Les Lunes sont dans des termes différents — des besoins émotionnels qui s'expriment différemment",'The Moons are in different terms — emotional needs expressed in different ways'],
        ['Données lunaires manquantes','Missing lunar data']]) _frEnPairs.push(pr);
    const _seen = new Set();
    const _uniq = _frEnPairs.filter(([fr]) => (fr && !_seen.has(fr)) ? _seen.add(fr) : false);
    _uniq.sort((x, y) => y[0].length - x[0].length); // composés avant simples
    const _escRe = (s) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    // Frontières accent-aware (le \b ASCII échoue autour de « é/œ » : « Carré », « Nœud »).
    const _wb = (s) => '(?<![A-Za-zÀ-ÿ0-9])' + _escRe(s) + '(?![A-Za-zÀ-ÿ0-9])';
    for (const [fr, en] of _uniq) {
        if (fr === en) continue;
        htmlOut = htmlOut.replace(new RegExp(_wb(fr), 'g'), en);
    }
}

return [{
    json: { success: true },
    binary: {
        html_file: {
            data: Buffer.from(__inject(String(htmlOut).replace('</body>', __spikkaCta('syn') + '</body>')), 'utf8').toString('base64'),
            mimeType: 'text/html',
            fileName: `index.html`
        }
    }
}];
} catch (_globalErr) {
    const errHtml = `<html><body style="font-family:sans-serif;padding:40px"><h1 style="color:#dc2626">${isEN ? 'Synastry report generation error' : 'Erreur de génération du rapport synastrie'}</h1><p>${_globalErr.message}</p><pre>${_globalErr.stack}</pre></body></html>`;
    return [{ json: { error: true, message: _globalErr.message, stack: _globalErr.stack }, binary: { html_file: { data: Buffer.from(errHtml,'utf8').toString('base64'), mimeType:'text/html', fileName:'index.html' } } }];
}
