    htmlOut = htmlOut.replace("__SYN_DOC_TOC_PLACEHOLDER__", _toc);
}

// SPIKKA : polices — tue tout reliquat Playfair / Source Sans -> Shrikhand / Montserrat (parité rapports SYN)
