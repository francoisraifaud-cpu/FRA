        const degTgt = posMapA[asp.planete_cible] ?? posMapB[asp.planete_cible];
        if (degSrc == null || degTgt == null) return;
        const a1 = d2r(e2s(degSrc)), a2 = d2r(e2s(degTgt));
        svg.push(`<line x1="${(CX+R_AS*Math.cos(a1)).toFixed(1)}" y1="${(CY+R_AS*Math.sin(a1)).toFixed(1)}" x2="${(CX+R_AS*Math.cos(a2)).toFixed(1)}" y2="${(CY+R_AS*Math.sin(a2)).toFixed(1)}" stroke="${st.col}" stroke-width="${st.w}" opacity="${st.op}"/>`);
    });

    const skipPl = ["Descendant","Imum Coeli","Ascendant","Milieu du Ciel"];
    const isLotName = nm => /^Lot /.test(nm);   // lots hermétiques exclus de la bi-roue (décision design)

    // Éventail angulaire à ORDRE ZODIACAL GARANTI (identique à la roue du THEME).
    const fanPlace = (arr, baseR, minGap) => {
        arr.forEach(p => { p.trueA = norm360(p.fullDeg); p.displayA = p.trueA; p.radius = baseR; });
        const n = arr.length; if (n === 0) return;
        arr.sort((a, b) => a.trueA - b.trueA);
        if (n === 1 || n * minGap >= 350) return;
        let cut = 0, maxGap = -1;
        for (let i = 0; i < n; i++) { const g = norm360(arr[(i + 1) % n].trueA - arr[i].trueA); if (g > maxGap) { maxGap = g; cut = (i + 1) % n; } }
        const order = []; for (let k = 0; k < n; k++) order.push(arr[(cut + k) % n]);
        const lin = [0]; for (let k = 1; k < n; k++) lin[k] = lin[k - 1] + norm360(order[k].trueA - order[k - 1].trueA);
        const orig = lin.slice();
        for (let k = 1; k < n; k++) if (lin[k] < lin[k - 1] + minGap) lin[k] = lin[k - 1] + minGap;
        let shift = 0; for (let k = 0; k < n; k++) shift += lin[k] - orig[k]; shift /= n;
        const span = lin[n - 1] - lin[0]; if (360 - span >= minGap) for (let k = 0; k < n; k++) lin[k] -= shift;
        const base = order[0].trueA; order.forEach((p, k) => { p.displayA = norm360(base + lin[k]); });
    };

    let svgLines = "", svgGlyphs = "";
    // Tick au degré réel + rappel UNIQUEMENT si le glyphe est décalé (façon Luna / THEME).
    const drawPointer = (p, glyphR, col, lw) => {
        const trueS = e2s(p.trueA);
        const t1 = pol(trueS, R_SI), t2 = pol(trueS, R_SI - 7);
        svgLines += `<line x1="${t1.x.toFixed(1)}" y1="${t1.y.toFixed(1)}" x2="${t2.x.toFixed(1)}" y2="${t2.y.toFixed(1)}" stroke="${col}" stroke-width="${lw}" opacity="0.8"/>`;
        const off = Math.abs(angDiff(p.displayA, p.trueA));
        if (off > 1.5) {
            const g = pol(e2s(p.displayA), glyphR);
            svgLines += `<line x1="${t2.x.toFixed(1)}" y1="${t2.y.toFixed(1)}" x2="${g.x.toFixed(1)}" y2="${g.y.toFixed(1)}" stroke="${col}" stroke-width="0.8" opacity="0.6"/>`;
        }
    };

    const buildRing = (planets, baseR, color) => {
        const arr = planets
            .filter(p => p.name && !skipPl.includes(p.name) && !isLotName(p.name))
            .map(p => ({ name: p.name, fullDeg: p.fullDeg, norm: ((p.fullDeg % 30) + 30) % 30, retro: !!p.retro }));
        fanPlace(arr, baseR, 6.5);
        arr.forEach(p => {
            const svgA = e2s(p.displayA), pos = pol(svgA, p.radius);
            const glyph = pGlyphs[p.name] || "?";
            drawPointer(p, p.radius + R_GLYPH, color, 1.0);
            const isMV = (glyph === "♀" || glyph === "♂");
            // ♀/♂ ont un œil plus petit dans Noto Sans Symbols 2 → on remonte leur corps pour égaliser la taille visuelle.
            const fsz = isMV ? 21 : 18;
            const extra = isMV ? `stroke-width="2.6"` : `stroke-width="2.3"`;
            svgGlyphs += `<text x="${pos.x.toFixed(1)}" y="${pos.y.toFixed(1)}" font-size="${fsz}" text-anchor="middle" dominant-baseline="central" fill="${color}" stroke="#ffffff" ${extra} paint-order="stroke" font-weight="bold" font-family="${GLYPH_FONT}">${glyph}</text>`;
            const _dd = Math.floor(p.norm); let _mm = Math.round((p.norm - _dd) * 60), _ddl = _dd; if (_mm === 60) { _mm = 0; _ddl = _dd + 1; }
            const degTxt = `${_ddl}°${String(_mm).padStart(2, "0")}'${p.retro ? " ℞" : ""}`;
            const lbl = pol(svgA, p.radius - R_GLYPH - 6);
            svgGlyphs += `<text x="${lbl.x.toFixed(1)}" y="${lbl.y.toFixed(1)}" font-size="7.5" text-anchor="middle" dominant-baseline="central" fill="${p.retro ? "#b23030" : color}" stroke="#ffffff" stroke-width="2.0" paint-order="stroke" font-weight="700" font-family="'Source Sans 3','Segoe UI Symbol','Noto Sans Symbols 2',sans-serif" letter-spacing="-0.3">${degTxt}</text>`;
        });
    };
    buildRing(bwPlanetsA, R_PA, COLOR_A);
    buildRing(bwPlanetsB, R_PB, COLOR_B);
    svg.push(svgLines);
    svg.push(svgGlyphs);

    // ── Étoiles fixes : un label PAR ÉTOILE (dédupliqué par personne), color-codées A/B, anti-chevauchement ──
    const ANGLE_HOSTS = ["Ascendant","Descendant","Milieu du Ciel","Imum Coeli"];
    // Longitudes écliptiques J2000 du catalogue (nœud « 3c. Étoiles Fixes ») : on ancre chaque étiquette
    // sur le degré RÉEL de l'étoile (ordre relatif stable à la précession) → ordre zodiacal garanti.
    const STAR_LON = {"Algol":56.22,"Pléiades":59.98,"Pleiades":59.98,"Aldébaran":69.78,"Aldebaran":69.78,"Sirius":104.05,"Régulus":149.83,"Regulus":149.83,"Spica":203.836,"Antarès":249.77,"Antares":249.77,"Véga":285.32,"Vega":285.32,"Fomalhaut":333.87,"Rigel":76.83,"Bételgeuse":88.75,"Betelgeuse":88.75,"Canopus":104.97,"Castor":110.25,"Pollux":113.22,"Procyon":115.78,"Arcturus":204.23,"Vindemiatrix":189.95,"Zubenelgenubi":225.08,"Zubeneschamali":229.37,"Deneb Algedi":323.55,"Scheat":359.37,"Achernar":345.32,"Deneb":335.33,"Mirach":30.43,"Mirfak":62.06,"Bellatrix":80.94,"Capella":81.95,"Alphecca":222.3,"Toliman":239.85,"Lesath":264.22,"Polis":273.23,"Facies":278.3,"Ascella":283.67,"Altaïr":301.66,"Altair":301.66,"Sadalmelik":333.48,"Markab":353.486,"Praesepe":127.282,"Asellus Borealis":127.538,"Asellus Australis":128.722};
    const starAcc = {};   // clé = couleur|nom (dédup par personne) -> conjonction la plus serrée
    const collectStars = (matches, posMap, color) => {
        (matches || []).forEach(em => {
            if (posMap[em.planete] === undefined) return;
            const name = isEN ? (em.etoile_en || em.etoile) : em.etoile;
            const lon = (typeof STAR_LON[name] === "number") ? STAR_LON[name]
                      : (typeof STAR_LON[em.etoile] === "number") ? STAR_LON[em.etoile]
                      : posMap[em.planete];
            const orb = (typeof em.orb === "number") ? em.orb : (parseFloat(em.orb) || 99);
            const isAngleHost = ANGLE_HOSTS.includes(em.planete);
            const key = color + "|" + name;
            const prev = starAcc[key];
            if (!prev || orb < prev.orb) starAcc[key] = { name, color, lon, orb, isAngleHost: isAngleHost || (prev && prev.isAngleHost) };
            else if (isAngleHost) prev.isAngleHost = true;
        });
    };
    collectStars(input.etoile_matches_a, posMapA, COLOR_A);
    collectStars(input.etoile_matches_b, posMapB, COLOR_B);
    // tri ZODIACAL (par longitude réelle) puis anti-chevauchement qui étale chaque grappe (A + B confondus) SANS permuter
    let starLabels = Object.values(starAcc).map(v => ({ name: v.name, color: v.color, norm: ((e2s(v.lon) % 360) + 360) % 360, isAngleHost: v.isAngleHost }));
    const STAR_GAP = 2.4;
    starLabels.sort((a, b) => a.norm - b.norm);
    if (starLabels.length > 1) {
        const clusters = []; let cur = [starLabels[0]];
        for (let i = 1; i < starLabels.length; i++) {
            if (starLabels[i].norm - starLabels[i - 1].norm < STAR_GAP) cur.push(starLabels[i]);
            else { clusters.push(cur); cur = [starLabels[i]]; }
        }
        clusters.push(cur);
        if (clusters.length > 1) {
            const first = clusters[0], last = clusters[clusters.length - 1];
            if ((first[0].norm + 360) - last[last.length - 1].norm < STAR_GAP) { clusters[0] = last.concat(first); clusters.pop(); }
        }
        for (const cl of clusters) {
            if (cl.length < 2) continue;
            const mean = cl.reduce((acc, L) => acc + L.norm, 0) / cl.length;
            const span = (cl.length - 1) * STAR_GAP;
            cl.forEach((L, k) => { L.norm = (((mean - span / 2 + k * STAR_GAP) % 360) + 360) % 360; });
        }
    }
    starLabels.forEach(L => {
        const svgA = L.norm;
        const flip = (svgA > 90 && svgA < 270);
        const rot = flip ? svgA + 180 : svgA;
        const anchor = flip ? "end" : "start";
        const base = L.isAngleHost ? R_OUT + 50 : R_OUT + 11;
        const a0 = pol(svgA, R_OUT + 1), a1 = pol(svgA, base - 2);
        svg.push(`<line x1="${a0.x.toFixed(1)}" y1="${a0.y.toFixed(1)}" x2="${a1.x.toFixed(1)}" y2="${a1.y.toFixed(1)}" stroke="${L.color}" stroke-width="0.6" opacity="0.55"/>`);
        const tp = pol(svgA, base);
        svg.push(`<text x="${tp.x.toFixed(1)}" y="${tp.y.toFixed(1)}" transform="rotate(${rot.toFixed(1)} ${tp.x.toFixed(1)} ${tp.y.toFixed(1)})" text-anchor="${anchor}" dominant-baseline="central" font-size="8.5" fill="${L.color}" font-style="italic" font-weight="600" font-family="'Source Sans 3',Arial,sans-serif">${L.name}</text>`);
    });

    svg.push(`<circle cx="${CX}" cy="${CY}" r="7" fill="#1a237e" stroke="white" stroke-width="2"/>`);
    svg.push(`<circle cx="${CX}" cy="${CY}" r="2.5" fill="white"/>`);

    // Parité SYN technique/final : roue à max-width 760px pour tenir SOUS l'intro + la légende
    // aspects + les pastilles personnes, sur la même page que le bandeau.
    const biWheelSVG = `<svg viewBox="-90 -90 980 980" xmlns="http://www.w3.org/2000/svg" style="width:100%;max-width:980px;height:auto;display:block;margin:auto;">${svg.join('')}</svg>`;

    // pastilles personnes (au-dessus de la roue, comme le SYN technique)
    const _personDots = `<div style="display:flex;flex-wrap:wrap;justify-content:center;gap:14px 26px;align-items:center;margin:0 0 10px">
