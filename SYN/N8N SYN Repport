        "Jupiter":"♃","Saturne":"♄","Uranus":"♅","Neptune":"♆","Pluton":"♇",
        "Chiron":"⚷","Nœud Nord":"☊","Nœud Sud":"☋","Part de Fortune":"⊕",
        "Lilith":"⚸","Cérès":"⚳","Vesta":"⚶","Junon":"⚵","Pallas":"⚴",
        "Lot du Mariage":"♥","Lot d'Éros":"♡","Lot de l'Esprit":"⊗",
        "Lot de Nécessité":"⊖","Lot de Némésis":"⚖","Lot de Basis":"⬡",
        "Lot d'Exaltation":"△","Lot du Daemon":"☿̦","Lot de Victoire":"⚜",
        "Lot du Père":"⚑","Lot de la Mère":"⚘","Lot de Maladie":"⚕",
        "Lot des Enfants":"✦","Lot de Voyage":"✈","Lot de Courage":"⚔",
        "Vertex":"⊹","Anti-Vertex":"⊹","Nœud moyen":"☊","Nœud vrai":"☊"
    };
    const signGlyphs = ["♈","♉","♊","♋","♌","♍","♎","♏","♐","♑","♒","♓"];
    // Identité graphique alignée sur la roue du THEME
    const ELEM_COLOR = ["#dc2626","#65a30d","#0ea5e9","#6366f1"];  // Feu, Terre, Air, Eau
    const signElem = i => ELEM_COLOR[i % 4];
    const NAVY = "#2E1560", NAVY2 = "#6B3FB5", TICK = "#D9C9F0";
    const GLYPH_FONT = "'Noto Sans Symbols 2','Segoe UI Symbol','Apple Symbols','Symbola','Arial Unicode MS',serif";
    // Couleurs propres à chaque thème (A = extérieur violet SPIKKA, B = intérieur magenta SPIKKA)
    const COLOR_A = "#2E1560", COLOR_B = "#C7359E";

    const CX = 400, CY = 400;
    const R_OUT = 376, R_SO = 372, R_SG = 351, R_SI = 330;
    const R_PA = 302, R_PB = 248;                 // anneaux des deux thèmes
    const R_HN = 198, R_HI = 170, R_AS = 158;
    const R_GLYPH = 13;

    const ascObjA = bwPlanetsA.find(p => p.name === "Ascendant");
    const ascDeg = ascObjA ? ascObjA.fullDeg : (bwCuspsA[0]?.degree || 0);

    const e2s = d => ((180 - (d - ascDeg)) % 360 + 360) % 360;
    const d2r = d => d * Math.PI / 180;
    const pol = (a, r) => ({ x: CX + r * Math.cos(d2r(a)), y: CY + r * Math.sin(d2r(a)) });
    const angDiff = (a, b) => { let d = ((a - b) % 360 + 360) % 360; return d > 180 ? d - 360 : d; };
    const norm360 = a => ((a % 360) + 360) % 360;

    let svg = [];
    svg.push(`<defs><radialGradient id="hgSyn" cx="50%" cy="50%" r="50%"><stop offset="0%" stop-color="#ffffff"/><stop offset="100%" stop-color="#f4f6fa"/></radialGradient></defs>`);
    svg.push(`<circle cx="${CX}" cy="${CY}" r="${R_OUT}" fill="white" stroke="${NAVY}" stroke-width="1.4"/>`);

    // Couronne des signes : wash élément discret (cohérent avec la roue du THEME)
    for (let i = 0; i < 12; i++) {
        const a1 = e2s(i*30), a2 = e2s((i+1)*30);
        const o1 = pol(a1,R_SO), o2 = pol(a2,R_SO), i1 = pol(a1,R_SI), i2 = pol(a2,R_SI);
        const col = signElem(i);
        svg.push(`<path d="M${i1.x.toFixed(2)},${i1.y.toFixed(2)} L${o1.x.toFixed(2)},${o1.y.toFixed(2)} A${R_SO},${R_SO} 0 0,0 ${o2.x.toFixed(2)},${o2.y.toFixed(2)} L${i2.x.toFixed(2)},${i2.y.toFixed(2)} A${R_SI},${R_SI} 0 0,1 ${i1.x.toFixed(2)},${i1.y.toFixed(2)} Z" fill="${col}" fill-opacity="0.13" stroke="none"/>`);
        const sb = e2s(i*30), b1 = pol(sb,R_SI), b2 = pol(sb,R_SO);
        svg.push(`<line x1="${b1.x.toFixed(2)}" y1="${b1.y.toFixed(2)}" x2="${b2.x.toFixed(2)}" y2="${b2.y.toFixed(2)}" stroke="${NAVY2}" stroke-width="1" opacity="0.55"/>`);
        const gp = pol(e2s(i*30+15), R_SG);
        svg.push(`<text x="${gp.x.toFixed(2)}" y="${gp.y.toFixed(2)}" font-size="22" text-anchor="middle" dominant-baseline="central" fill="${col}" font-family="${GLYPH_FONT}" font-weight="bold">${signGlyphs[i]}</text>`);
    }

    // Graduations 5° / 10° vers l'EXTÉRIEUR (dans la bande du signe)
    for (let deg = 0; deg < 360; deg++) {
        if (deg % 5 !== 0 || deg % 30 === 0) continue;
        const isTen = (deg % 10 === 0);
        const len = isTen ? 12 : 7;
        const ta = e2s(deg), t1 = pol(ta, R_SI), t2 = pol(ta, R_SI + len);
        svg.push(`<line x1="${t1.x.toFixed(2)}" y1="${t1.y.toFixed(2)}" x2="${t2.x.toFixed(2)}" y2="${t2.y.toFixed(2)}" stroke="${isTen ? NAVY2 : "#8c99b8"}" stroke-width="${isTen ? 1.4 : 0.9}" opacity="${isTen ? 0.9 : 0.7}"/>`);
    }

    svg.push(`<circle cx="${CX}" cy="${CY}" r="${R_SI}" fill="none" stroke="${NAVY2}" stroke-width="1.4"/>`);
    svg.push(`<circle cx="${CX}" cy="${CY}" r="${(R_PA + R_PB) / 2}" fill="none" stroke="#d0d6e4" stroke-width="0.7" stroke-dasharray="3,4"/>`);
    svg.push(`<circle cx="${CX}" cy="${CY}" r="${R_HI}" fill="url(#hgSyn)" stroke="#b9c2d6" stroke-width="1"/>`);

    const axMap = {0:"AC",3:"IC",6:"DC",9:"MC"};
    if (bwCuspsA.length >= 12) {
        for (let i = 0; i < 12; i++) {
            const cEcl = bwCuspsA[i].degree, svgAng = e2s(cEcl);
            const isAxis = [0,3,6,9].includes(i);
            const pOut = pol(svgAng,R_SI), pIn = pol(svgAng,R_HI);
            svg.push(`<line x1="${pOut.x.toFixed(2)}" y1="${pOut.y.toFixed(2)}" x2="${pIn.x.toFixed(2)}" y2="${pIn.y.toFixed(2)}" stroke="${isAxis ? NAVY : "#c2cbe0"}" stroke-width="${isAxis ? 2.6 : 0.8}" ${isAxis ? "" : 'stroke-dasharray="4,4"'}/>`);
            const nxEcl = bwCuspsA[(i+1)%12].degree, span = (nxEcl - cEcl + 360)%360;
            const midEcl = (cEcl + span/2 + 360)%360, nPos = pol(e2s(midEcl), R_HN);
            svg.push(`<text x="${nPos.x.toFixed(2)}" y="${nPos.y.toFixed(2)}" font-size="20" text-anchor="middle" dominant-baseline="central" fill="#9aa6c0" font-weight="700" font-family="'Source Sans 3',Arial,sans-serif">${i+1}</text>`);
            if (isAxis) {
                const axPos = pol(svgAng, R_OUT + 24);
                const _ad = ((cEcl % 360) + 360) % 360, _adeg = _ad % 30;
                const _add = Math.floor(_adeg); let _amm = Math.round((_adeg - _add) * 60), _addl = _add; if (_amm === 60) { _amm = 0; _addl += 1; }
                svg.push(`<text x="${axPos.x.toFixed(2)}" y="${(axPos.y - 8).toFixed(2)}" font-size="16" text-anchor="middle" dominant-baseline="central" fill="${NAVY}" font-weight="900" font-family="'Source Sans 3',Arial,sans-serif">${axMap[i]}</text>`);
                svg.push(`<text x="${axPos.x.toFixed(2)}" y="${(axPos.y + 8).toFixed(2)}" font-size="9.5" text-anchor="middle" dominant-baseline="central" fill="${NAVY2}" font-weight="700" font-family="'Source Sans 3',Arial,sans-serif">${_addl}°${String(_amm).padStart(2,"0")}'</text>`);
            }
        }
    }

    const aspDef = { "Conjonction":{col:"#9900dd",w:2.0,op:0.85,z:5}, "Opposition":{col:"#cc0000",w:1.8,op:0.8,z:4}, "Carré":{col:"#ee4400",w:1.5,op:0.75,z:3}, "Trigone":{col:"#1155cc",w:1.2,op:0.65,z:2}, "Sextile":{col:"#009944",w:0.9,op:0.55,z:1} };
    // Trame d'aspects = corps « aspectants » classiques uniquement (planètes + luminaires + Chiron),
    // côté A ET côté B → centre lisible (mêmes critères que la roue du THEME).
    const ASPECT_BODIES = new Set(["Soleil","Lune","Mercure","Vénus","Mars","Jupiter","Saturne","Uranus","Neptune","Pluton","Chiron"]);
    const posMapA = {}, posMapB = {};
    bwPlanetsA.forEach(p => { if (p.name) posMapA[p.name] = p.fullDeg; });
    bwPlanetsB.forEach(p => { if (p.name) posMapB[p.name] = p.fullDeg; });
    const bwAspects = [...interAspectsTier1BtoA, ...interAspectsTier1AtoB]
        .filter(a => aspDef[a.aspect] && ASPECT_BODIES.has(a.planete_source) && ASPECT_BODIES.has(a.planete_cible));
    bwAspects.sort((a,b) => (aspDef[a.aspect]?.z||0)-(aspDef[b.aspect]?.z||0));
    bwAspects.forEach(asp => {
        const st = aspDef[asp.aspect];
