// ── HELPER CONFIGURATION RENDER ──
function renderConfigItem(c) {
    const sc = c.puissanceScore || 0;
    const cls = sc >= 120 ? 'score-absolu' : sc >= 80 ? 'score-majeur' : sc >= 50 ? 'score-signif' : 'score-mineur';
    const lbl = c.prioriteLabel || (sc >= 120 ? (isEN ? 'ABSOLUTE' : 'PRIORITÉ ABSOLUE') : sc >= 80 ? (isEN ? 'Major' : 'Majeure') : sc >= 50 ? (isEN ? 'Significant' : 'Significative') : (isEN ? 'Minor' : 'Mineure'));
    const isSub = c.isSubConfig || false;
    const subCls = isSub ? ' config-item-sub' : '';
    const typeCls = isSub ? 'config-type-sub' : 'config-type';
    const subTag = c.parentTag ? ` <span class="tag-sub-config">↳ ${escH(c.parentTag)}</span>` : '';
    const scoreBadge = sc > 0 ? `<span class="score-badge ${cls}">Score ${sc} — ${lbl}</span>` : '';
    // Parité THEME : type + score, puis description seule. On retire le boilerplate
    // répété (« — concentration… ») ; les planètes ne sont plus re-listées (elles
    // figurent déjà dans la description).
    const desc = (c.description || '').replace(/\s*[—–-]\s*concentration[^—–]*$/i, '').trim();
    const descStyle = isSub ? ' style="font-size:0.88em;color:var(--ink-soft);margin-top:2px"' : ' style="margin-top:3px"';
    return `<div class="config-item${subCls}"><div class="${typeCls}">${escH(c.type)}${scoreBadge}${subTag}</div><div${descStyle}>${escH(desc)}</div></div>`;
}

