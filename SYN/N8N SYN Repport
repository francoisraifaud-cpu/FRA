</div>`;

// ── BI-ROUE SVG SYNASTRIQUE ──
const biwheel = input.biwheel || {};
// Dédoublonnage par nom : la source émet parfois le Vertex en double (même degré) → évite le double glyphe sur la bi-roue.
const _dedupeByName = arr => { const seen = new Set(); return (arr || []).filter(p => { if (!p || !p.name) return true; if (seen.has(p.name)) return false; seen.add(p.name); return true; }); };
const bwPlanetsA = _dedupeByName(biwheel.planets_a);
const bwPlanetsB = _dedupeByName(biwheel.planets_b);
const bwCuspsA = biwheel.cusps_a || [];

if (bwPlanetsA.length > 0 && bwPlanetsB.length > 0) {

    const pGlyphs = {
