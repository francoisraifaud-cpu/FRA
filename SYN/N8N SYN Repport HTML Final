// v7.6.0 — Synthèse Relationnelle découpée en chapitres : une bannière marine + une carte
// blanche par section « ## » du texte LLM. Rendu structuré « pro » harmonisé avec THEME et
// pagination saine (chaque chapitre est un bloc autonome, plus de mur de 4 pages d'un bloc).
// Découpage partagé du texte LLM en chapitres (« ## titre ## »), utilisé à la fois
// par le rendu des sections et par le sommaire (pour que les deux restent alignés).
function _parseSyntheseBlocks() {
    if (!synthese) return [];
    // NOUVEAU FORMAT (Reassemble Trad SYN v4) : chapitres re-tissés structurés.
    // Le titre vient des métadonnées ; le corps contient des sous-titres « ## »
    // (punchlines) + un « ## En pratique » -> rendu via mdRecit().
    if (Array.isArray(synthese.chapters) && synthese.chapters.length) {
        return synthese.chapters
            .filter((c) => c && (String(c.title || '').trim() || String(c.body || '').trim()))
            .map((c) => ({
                title: String(c.title || '').replace(/\*/g, '').replace(/^\d+\.\s*/, '').trim(),
                // _cleanSynRaw : retire notamment toute ligne « Note globale d'harmonie »
                // émise par le LLM (rendue désormais en bloc verdict déterministe).
                body: _cleanSynRaw(String(c.body || '')).split('\n'),
                _recit: true,
            }));
    }
    if (!String(synthese.llm_text || '').trim()) return [];
    const raw = _cleanSynRaw(String(synthese.llm_text));
    const lines = raw.split('\n');
    const blocks = [];
    let cur = null;
    for (const ln of lines) {
        const hm = ln.match(/^#{1,3}\s+(.+?)\s*#*\s*$/);
        if (hm && !/^#{1,3}\s*$/.test(ln)) {
            if (cur) blocks.push(cur);
            cur = { title: hm[1].replace(/\*/g, '').replace(/^\d+\.\s*/, '').trim(), body: [] };
        } else {
            if (!cur) cur = { title: '', body: [] };
            cur.body.push(ln);
        }
    }
    if (cur) blocks.push(cur);
    return blocks.filter((b) => b.title || String(b.body.join('')).trim());
}

