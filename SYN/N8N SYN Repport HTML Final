const esc = (t) => String(t).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');

const inline = (t) => {
  const escaped = esc(t);
  return escaped
    .replace(/\*\*\*(.*?)\*\*\*/g, '<strong><em>$1</em></strong>')
    .replace(/\*\*(.*?)\*\*/g, '<strong style="color:var(--primary);font-weight:700;background:rgba(255,166,246,0.18);padding:0 3px;border-radius:3px;">$1</strong>')
    .replace(/\*(.*?)\*/g, '<em>$1</em>');
};

// Retire les parenthèses explicatives en fin de titre numéroté (ex : "1. La nature du lien (Typologie)" → "1. La nature du lien").
const _stripHeadingParens = (t) => String(t || '').replace(
  /^([ \t]*[#*]{0,3}[ \t]*\d[\d.]*[.)][ \t]+[^\n(]+?)[ \t]*\([^\n)]*\)([ \t]*[#*]{0,3}[ \t]*)$/gm,
  '$1$2'
);

// Nettoyage du texte LLM de synthèse, partagé par les rapports :
//  - renomme l'intitulé jargonneux « Verdict final + Bande qualitative » en libellé client clair
//  - SUPPRIME toute ligne d'harmonie globale émise par le LLM (« Note globale d'harmonie : XX/100 — … »)
//    car elle est désormais rendue de façon DÉTERMINISTE depuis les données moteur (cf. _harmonyVerdict()),
//    ce qui évite tout doublon et tout parsing hasardeux d'une sortie LLM non garantie.
const _cleanSynRaw = (t) => _stripHeadingParens(String(t || ''))
  .replace(/Verdict final\s*\+\s*Bande qualitative|Final verdict\s*\+\s*Qualitative band/gi, isEN ? 'In summary' : 'En résumé')
  .replace(/^.*Note globale d['’]?harmonie.*$/gim, '')
  .replace(/^.*Overall harmony score.*$/gim, '');

const md = (text) => {
  if (!text) return `<p style="color: #aaa; font-style: italic; font-size: 14px;">${isEN ? 'Content not received...' : 'Contenu non reçu...'}</p>`;
  text = String(text)
    .replace(/^([\*]{0,3}\d[\d.]*[\.\)]\s[^\n]{4,})\n([^\n\*]{3,80}[\*]{1,3})/gm, '$1 $2');
  text = text.replace(/^([\*]{0,3}\d[\d.]*[\.\)]\s[^\n]*\([^\n)]*)\n([\wÀ-ÿ\u2019\u2018'-]+\))/gm, '$1 $2');
  text = text.replace(/^([\*]{0,3}\d[\d.]*[\.\)]\s[^\n]{30,140})\n([^\n\d\*\#\.]{2,25})\n/gm, '$1 $2\n');
  text = text.replace(/^(#{1,3} .+?)\s+#{2,}\s+([^\n]+)$/gm, '$1\n$2');
  const lines = text.split('\n');
  const out = [];
  let inList = false;
  for (let line of lines) {
    const isBullet = /^[-*]\s+\S/.test(line) && !/^\*\*/.test(line);
    if (!isBullet && inList) { out.push('</ul>'); inList = false; }
    line = line.replace(/\s+#+\s*$/, '');
    const stripped = line.replace(/\*/g, '');
    let lineHandled = false;

    if (/^#{1,2} /.test(line)) {
      line = '### ' + line.replace(/^#{1,2} /, '').replace(/\*/g, '');
    } else if (/^#{3,} /.test(line)) {
      line = '#### ' + line.replace(/^#{3,} /, '').replace(/\*/g, '');
    } else {
      const subMatch = stripped.match(/^(\d+\.\d+[.)]\s+)(.+)$/);
      if (subMatch) {
        const prefix = subMatch[1], rest = subMatch[2];
        const colon = rest.indexOf(' : ');
        if (colon > 0 && colon <= 90) {
          const after = rest.slice(colon + 3);
          if (after.length > 60) {
            out.push(`<h5 class="sk-h5">${esc(prefix + rest.slice(0, colon))}</h5>`);
            if (after.trim()) out.push(`<p class="sk-p">${inline(after)}</p>`);
            lineHandled = true;
          } else if ((prefix + rest).length <= 130) { line = '#### ' + prefix + rest; }
        } else if ((prefix + rest).length <= 130) { line = '#### ' + prefix + rest; }
      } else {
        const mainMatch = stripped.match(/^(\d+[.)]\s+)(.+)$/);
        if (mainMatch) {
          const prefix = mainMatch[1], rest = mainMatch[2];
          if ((prefix + rest).length <= 155) { line = '### ' + prefix + rest; }
          else {
            const colon = rest.indexOf(' : ');
            if (colon > 0 && colon <= 120) {
              const after = rest.slice(colon + 3);
              out.push(`<h4 class="sk-h4">${esc(prefix + rest.slice(0, colon))}</h4>`);
              if (after.trim()) out.push(`<p class="sk-p">${inline(after)}</p>`);
              lineHandled = true;
            } else { line = '### ' + prefix + rest; }
          }
        } else if (/^\*{2,3}[^*]{4,120}\*{2,3}$/.test(line)) { line = '### ' + stripped; }
        else if (/^(conclusion|synthèse|en\s+synthèse|en\s+conclusion|recommandation)/i.test(stripped) && stripped.length < 120) {
          const colonIdx = stripped.indexOf(' : ');
          if (colonIdx > 0 && colonIdx <= 50 && stripped.slice(colonIdx + 3).trim().length > 20) {
            out.push(`<h4 class="sk-h4">${esc(stripped.slice(0, colonIdx))}</h4>`);
            out.push(`<p class="sk-p">${inline(stripped.slice(colonIdx + 3))}</p>`);
            lineHandled = true;
          } else { line = '### ' + stripped; }
        }
      }
    }

    if (lineHandled) continue;
    if (line.startsWith('### ')) {
      out.push(`<h4 class="sk-h4">${esc(line.replace(/^### /, ''))}</h4>`);
    } else if (line.startsWith('#### ')) {
      out.push(`<h5 class="sk-h5">${esc(line.replace(/^#### /, ''))}</h5>`);
    } else if (isBullet) {
      if (!inList) { out.push('<ul class="sk-ul">'); inList = true; }
      out.push(`<li>${inline(line.replace(/^[-*]\s+/, ''))}</li>`);
    } else if (line.startsWith('---')) {
      out.push('<hr class="sk-hr">');
    } else if (line.trim() === '') {
      out.push('<div style="height:10px;"></div>');
    } else {
      out.push(`<p class="sk-p">${inline(line)}</p>`);
    }
  }
  if (inList) out.push('</ul>');
  return out.join('');
};

// Rendu RÉCIT (iso THEME final) : les sous-titres « ## » deviennent des cartes
// « punchline ✦ », et « ## En pratique » un encart rose signature. Utilisé pour
// les chapitres re-tissés par le Traducteur SYN (format structuré chapters[]).
const _PRATIQUE_RE = /^(en pratique|in practice|à retenir|to remember|vos conseils|your advice|conseils pour|advice for)/i;
const mdRecit = (text) => {
  if (!text || !String(text).trim()) return md(text);
  const lines = String(text).split('\n');
  const out = [];
  let inList = false, inPunchline = false;
  const closeList = () => { if (inList) { out.push('</ul>'); inList = false; } };
  const closePunch = () => { if (inPunchline) { out.push('</div></div></div>'); inPunchline = false; } };
  for (let raw of lines) {
    let line = raw;
    const isBullet = /^[-*]\s+\S/.test(line) && !/^\*\*/.test(line);
    if (!isBullet) closeList();
    line = line.replace(/\s+#+\s*$/, '');
    if (/^#{1,3}\s/.test(line)) {
      closePunch();
      const label = line.replace(/^#{1,3}\s/, '').replace(/\*/g, '').trim();
      if (_PRATIQUE_RE.test(label)) {
        out.push(`<div class="sk-pratique"><span class="sk-pratique-tag">${esc(label)}</span>`);
        out.push('__SK_PRATIQUE_OPEN__');
      } else {
        out.push(`<div class="sk-punchline"><div class="sk-punchline-icon">✦</div><div class="sk-punchline-content"><h4 class="sk-punchline-title">${esc(label)}</h4><div class="sk-punchline-text">`);
        inPunchline = true;
      }
    } else if (isBullet) {
      if (!inList) { out.push('<ul class="sk-ul">'); inList = true; }
      out.push(`<li>${inline(line.replace(/^[-*]\s+/, ''))}</li>`);
    } else if (line.startsWith('---')) {
      closePunch();
      out.push('<hr class="sk-hr">');
    } else if (line.trim() === '') {
      out.push('<div style="height:4px;"></div>');
    } else {
      out.push(`<p class="sk-p">${inline(line)}</p>`);
    }
  }
  closeList();
  closePunch();
  let joined = out.join('');
  if (joined.includes('__SK_PRATIQUE_OPEN__')) {
    joined = joined.replace(/__SK_PRATIQUE_OPEN__/g, '') + '</div>';
  }
  return joined;
};

