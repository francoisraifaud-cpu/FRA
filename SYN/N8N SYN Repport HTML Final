  if (h >= 68) return { lab: isEN ? 'Very fluid' : 'Très fluide', bg:'#dcfce7', txt:'#166534' };
  if (h >= 55) return { lab: isEN ? 'Rather fluid' : 'Plutôt fluide', bg:'#dbeafe', txt:'#1e40af' };
  if (h >= 45) return { lab: isEN ? 'Balanced' : 'Équilibré', bg:'#fef3c7', txt:'#92400e' };
  if (h >= 32) return { lab: isEN ? 'To nurture' : 'À cultiver', bg:'#fed7aa', txt:'#c2410c' };
