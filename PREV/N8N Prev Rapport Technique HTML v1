    const _saRe = /^☀ ARC SOLAIRE :\s*(.+?)\s+dirigé\s+\(([^,]+),\s*M(\d+)\)\s+en\s+(.+?)\s+avec\s+(.+?)\s+natal\s+\(M(\d+)\)\s+—\s+orbe\s+([\d.]+)°\s*([\s\S]*)$/;
    progressionsRaw.aspects.forEach(a => {
        if (typeof a !== 'string' || a.indexOf('ARC SOLAIRE') === -1) return;
        const m = a.match(_saRe);
        if (m) {
            let note = (m[8] || '').trim()
                .replace(/^\([^)]*\)\s*/, '')
                .replace(/\[poids\s+[\d.]+\]\.?\s*/i, '')
                .replace(/\s*Direction lente et structurante[^.]*\.?\s*/gi, '')
                .replace(/^[\s.…—\-]+/, '')
                .trim();
            _solarArcRows.push({
                directed: m[1].trim(),
                dirSign: m[2].trim(),
                dirHouse: m[3],
                aspect: m[4].trim(),
                target: m[5].trim(),
                targetHouse: m[6],
                orbRaw: m[7],
                note
            });
        } else {
            _solarArcRows.push({ fallback: a });
        }
    });
}

/** N8N Prev Repport : pas de chaînes « ☀ ARC SOLAIRE » dans progressionsRaw.aspects — données dans chaque item .arcs_solaires { pSA, pNat, aspect, orbe, saSign, saHouse }. */
if (_solarArcRows.length === 0 && maisons?.length) {
    const _saSeen = new Set();
    maisons.forEach(it => {
        (it.arcs_solaires || []).forEach(a => {
            const orbN = typeof a.orbe === 'number' ? a.orbe : parseFloat(a.orbe);
            const orbKey = Number.isFinite(orbN) ? orbN.toFixed(3) : String(a.orbe ?? '');
            const key = `${a.pSA}|${a.pNat}|${a.aspect}|${orbKey}`;
            if (_saSeen.has(key)) return;
            _saSeen.add(key);
            const orb = Number.isFinite(orbN) ? orbN : 0;
            let note = '';
            if (orb < 0.15) note = isEN ? 'Near-exact arc' : 'Arc quasi-exact';
            else if (orb < 0.4) note = isEN ? 'Tight arc' : 'Arc serré';
            _solarArcRows.push({
                directed: a.pSA,
                dirSign: a.saSign || '—',
                dirHouse: String(a.saHouse ?? '?'),
                aspect: a.aspect,
                target: a.pNat,
                targetHouse: String(it.maison),
                orbRaw: orb.toFixed(2),
                note
            });
        });
    });
}

