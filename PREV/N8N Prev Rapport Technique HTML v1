    //  - signes : cuspide SEULE en "Cuspide : X" (sans glyphe, sans degres, sans interception)
    //  - planetes : nom seul (pas de glyphe ni position)
    //  - etoiles : pastille bleu marine (sk-pill--star)
    html = html.replace(/<div class="structure-signs">((?:<div class="structure-item">[\s\S]*?<\/div>)*)<\/div>/g, function(m, inner){
      var items = inner.match(/<div class="structure-item">[\s\S]*?<\/div>/g) || [];
      if (!items.length) return '<div class="structure-signs"></div>';
      var raw = items[0].replace(/<[^>]+>/g, "").replace(/\([^)]*°\)/g, "")
        .replace(/[\u2600-\u27BF\u2190-\u21FF\u{1F300}-\u{1FAFF}]/gu, "").replace(/\s{2,}/g, " ").trim();
      return '<div class="structure-signs"><span class="sk-pill">Cuspide : ' + raw + '</span></div>';
    });
    html = html.replace(/<div class="natal-planet-item[^"]*">[\s\S]*?<span class="natal-name">([\s\S]*?)<\/span>[\s\S]*?<\/div>/g,
      function(m, name){ return '<span class="sk-pill">' + name.replace(/<[^>]+>/g, "").trim() + '</span>'; });
    html = html.replace(/<span class="natal-star-item">/g, '<span class="natal-star-item sk-pill sk-pill--star">');

    // 2quinquies) Retirer les emojis decoratifs non harmonises (diamant, cadenas, equerre)
    html = html.replace(/[\u{1F537}\u{1F512}\u{1F4D0}]\s*/gu, "");

    // 3) Injecter la couche charte avant le DERNIER </style>
    var idx = html.lastIndexOf("</style>");
    if (idx !== -1) html = html.slice(0, idx) + "\n" + HARMO + "\n" + html.slice(idx);
    return html;
  } catch (e) { return html; }
}

