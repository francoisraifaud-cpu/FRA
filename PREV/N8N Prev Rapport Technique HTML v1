        const _sDeg = (_trueNodeDeg + 180) % 360;
        const _sSignIdx = Math.floor(_sDeg / 30) % 12;
        const _signsD = ["Bélier","Taureau","Gémeaux","Cancer","Lion","Vierge","Balance","Scorpion","Sagittaire","Capricorne","Verseau","Poissons"];
        const _sSign = _signsD[_sSignIdx];
        const nordData = cleanedPlanetes["Nœud Nord"];
        const nordHouse = nordData ? parseInt(nordData.house, 10) : 0;
        const _sHouse = nordHouse > 0 ? ((nordHouse + 5) % 12) + 1 : "?";
        cleanedPlanetes["Nœud Sud"] = { sign: _sSign, house: _sHouse, deg: `${((_sDeg??0) % 30).toFixed(2)}° ${_sSign}`, retro: "", fullDegree: _sDeg };
