function prevHeatmapTitles(hd, isEN) {
  var gr = (hd && hd.granularity) || 'annual';
  var subFR = {
    daily:   'Les domaines les plus actifs de la journée',
    weekly:  'Où la semaine est la plus active, jour par jour',
    monthly: 'Où le mois est le plus actif, semaine par semaine',
    annual:  "Où l'année est la plus active, mois par mois",
  };
  var subEN = {
    daily:   'The most active areas of the day',
    weekly:  'Where the week is most active, day by day',
    monthly: 'Where the month is most active, week by week',
    annual:  'Where the year is most active, month by month',
  };
  return {
    title: isEN ? 'Intensity by life area' : 'Intensité par domaine de vie',
    subtitle: isEN ? (subEN[gr] || subEN.annual) : (subFR[gr] || subFR.annual),
  };
}

function _prevHeatTrCols(labels, isEN) {
  if (!isEN || !Array.isArray(labels)) return labels || [];
  var MONTH = { 'Jan':'Jan','Fév':'Feb','Mar':'Mar','Avr':'Apr','Mai':'May','Jun':'Jun','Jul':'Jul','Aoû':'Aug','Sep':'Sep','Oct':'Oct','Nov':'Nov','Déc':'Dec' };
  var DAY = { 'Lun':'Mon','Mar':'Tue','Mer':'Wed','Jeu':'Thu','Ven':'Fri','Sam':'Sat','Dim':'Sun' };
  var isDays = labels.some(function (l) { return /^(Lun|Mer|Jeu|Ven|Sam|Dim)/.test(String(l)); });
  return labels.map(function (l) {
    var s = String(l);
    var m = s.match(/^([A-Za-zÀ-ÿ]+)(.*)$/);
    if (!m) return s;
    var head = m[1], tail = m[2] || '';
    if (isDays && DAY[head]) return DAY[head] + tail;
    if (MONTH[head]) return MONTH[head] + tail;
    return s.replace(/^Sem\.?\s*/, 'Week ');
  });
}

function renderPrevHeatmapInner(hd, opts) {
  opts = opts || {};
  if (!hd || !hd.grid || !hd.grid.length) return '';
  var isEN = !!opts.isEN;
  var esc = opts.esc || function (s) {
    return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) {
      return { '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;' }[c];
    });
  };

  var PRIMARY = '#2E1560', INK = '#2A2342', INK_SOFT = '#7A7393';
  var LINE = 'rgba(46,21,96,0.10)', HL = 'rgba(255,166,246,0.18)';
  var TENSION = '#B0228C', SUPPORT = '#A678DB';
  var hc = function (r) { if (r <= 0) return '#FBF8FF'; if (r < 0.25) return '#EFE3FB'; if (r < 0.5) return '#D9BEF2'; if (r < 0.75) return SUPPORT; return PRIMARY; };
  var tc = function (r) { return r >= 0.5 ? '#fff' : PRIMARY; };
  var nBg = function (n) { return n >= 75 ? PRIMARY : n >= 50 ? SUPPORT : n >= 25 ? '#D9BEF2' : '#EFE3FB'; };
  var nTc = function (n) { return n >= 50 ? '#fff' : PRIMARY; };

  var houses = _prevHeatmapHouses(isEN);
  var grid = hd.grid;
  var maxI = hd.maxIntensity || Math.max.apply(null, [1].concat([].concat.apply([], grid)));
  var norm = hd.normalized || [];
  var tenT = hd.tensionTotals || [];
  var supT = hd.supportTotals || [];
  var top3 = hd.top3 || [];
  var cols = _prevHeatTrCols(hd.colLabels || [], isEN);
  var gran = hd.granularity || 'annual';
  var isDaily = gran === 'daily' || cols.length <= 1;

  var gauge = function (tP, sP, mini) {
    var box = mini ? 'width:32px;height:8px;margin:0 4px' : 'width:100%;max-width:60px;height:9px';
    return '<span style="display:inline-flex;' + box + ';border-radius:5px;overflow:hidden;border:1px solid ' + LINE + ';vertical-align:middle">'
      + '<span style="background:' + TENSION + ';width:' + tP + '%"></span>'
      + '<span style="background:' + SUPPORT + ';width:' + sP + '%"></span></span>';
  };
  var B = function (t) { return '<strong style="color:' + PRIMARY + ';font-weight:700;background:' + HL + ';padding:0 3px;border-radius:3px">' + t + '</strong>'; };

  var pedagStyle = 'background:#FBF8FF;border:1px solid ' + LINE + ';border-radius:8px;padding:14px 18px;margin:0 0 16px;font-size:13px;color:' + INK + ';line-height:1.55';
  var pedag;
  if (isDaily) {
    pedag = isEN
      ? B('💡 How to read this ranking?') + '<br>Each <strong>row</strong> is an area of your life (the 12 houses, in plain words), ranked from the most active to the calmest for the day. The score goes from ' + B('0') + ' (calm) to ' + B('100') + ' (peak). The ' + B('Balance') + ' gauge shows whether energies are rather demanding (' + gauge(75, 25, true) + 'pink) or supportive (' + gauge(25, 75, true) + 'purple).'
      : B('💡 Comment lire ce classement&nbsp;?') + '<br>Chaque <strong>ligne</strong> est un domaine de votre vie (les 12 maisons, décrites en clair), classées de la plus active à la plus calme sur la journée. La note va de ' + B('0') + ' (calme) à ' + B('100') + ' (temps fort). La jauge ' + B('Équilibre') + ' indique si les énergies y sont plutôt exigeantes (' + gauge(75, 25, true) + 'rose) ou porteuses (' + gauge(25, 75, true) + 'violet).';
  } else {
    pedag = isEN
      ? B('💡 How to read this map?') + '<br>Each <strong>row</strong> is an area of your life (the 12 houses, in plain words) and each <strong>column</strong> a period. The ' + B('darker') + ' a cell, the more active that area is then: from ' + B('0') + ' (calm) to ' + B('100') + ' (peak). The ' + B('Score') + ' column sums up the area\'s intensity over the whole period. The ' + B('Balance') + ' gauge shows whether energies are rather demanding (' + gauge(75, 25, true) + 'pink) or supportive (' + gauge(25, 75, true) + 'purple).'
      : B('💡 Comment lire cette carte&nbsp;?') + '<br>Chaque <strong>ligne</strong> est un domaine de votre vie (les 12 maisons, décrites en clair) et chaque <strong>colonne</strong> une période. Plus une case est ' + B('foncée') + ', plus ce domaine est actif à ce moment-là&nbsp;: la note va de ' + B('0') + ' (calme) à ' + B('100') + ' (temps fort). La colonne ' + B('Note') + ' résume l\'intensité du domaine sur toute la période. La jauge ' + B('Équilibre') + ' indique si les énergies y sont plutôt exigeantes (' + gauge(75, 25, true) + 'rose) ou porteuses (' + gauge(25, 75, true) + 'violet).';
  }

  var noteLab = isEN ? 'Score' : 'Note';
  var eqLab = isEN ? 'Balance' : 'Équilibre';
  var domLab = isEN ? 'Life area' : 'Domaine de vie';
  var calmLab = isEN ? 'calm' : 'calme';
  // Domaine réellement sans transit datable sur la période : afficher « calme » (honnête),
  // jamais « 0/100 » qui donne une impression de case cassée. Le 0 = domaine paisible, pas une erreur.
  var noteCell = function (note) {
    if (note <= 0) return '<td style="padding:4px 2px;border-radius:4px;font-weight:600;font-size:9px;font-style:italic;background:#FBF8FF;color:' + INK_SOFT + '">' + calmLab + '</td>';
    return '<td style="padding:4px 2px;border-radius:4px;font-weight:800;font-size:10.5px;background:' + nBg(note) + ';color:' + nTc(note) + '">' + note + '/100</td>';
  };

  var order = [];
  for (var i = 0; i < grid.length; i++) order.push(i);
  if (isDaily) { order.sort(function (a, b) { return (norm[b] || 0) - (norm[a] || 0); }); }

  var thBase = 'padding:6px 2px;font-weight:700;overflow:hidden;white-space:nowrap';
  var tableStyle = 'width:100%;border-collapse:collapse;font-size:11px;text-align:center;table-layout:fixed';

  var h = '<div style="overflow-x:auto"><table style="' + tableStyle + '"><thead><tr style="background:' + PRIMARY + ';color:#fff">';
  h += '<th style="' + thBase + ';width:180px;text-align:left;padding-left:8px">' + domLab + '</th>';
  if (!isDaily) cols.forEach(function (c) { h += '<th style="' + thBase + '">' + esc(c) + '</th>'; });
  h += '<th style="' + thBase + ';width:46px;font-size:9.5px">' + noteLab + '</th>';
  h += '<th style="' + thBase + ';width:70px;font-size:8.5px;letter-spacing:-0.2px">' + eqLab + '</th></tr></thead><tbody>';

  order.forEach(function (i) {
    var ho = houses[i] || { n: i + 1, main: 'M' + (i + 1), sub: '' };
    var note = norm[i] !== undefined ? norm[i] : 0;
    var tv = tenT[i] || 0, sv = supT[i] || 0, den = tv + sv;
    var tP = den > 0 ? Math.round(tv / den * 100) : 50, sP = 100 - tP;
    var hot = top3.indexOf(i + 1) !== -1;
    h += '<tr>';
    h += '<td style="text-align:left;padding:5px 8px 5px 6px;line-height:1.15;white-space:normal">'
      + (hot ? '🔥 ' : '')
      + '<span style="font-weight:700;color:' + PRIMARY + ';font-size:11px">M' + ho.n + ' · ' + esc(ho.main) + '</span>'
      + '<span style="display:block;color:' + INK_SOFT + ';font-size:9.5px;line-height:1.25;margin-top:1px">' + esc(ho.sub) + '</span></td>';
    if (!isDaily) {
      grid[i].forEach(function (v) {
        var r = maxI > 0 ? Math.min(1, v / maxI) : 0; // C2 : borne absolue → un pic peut dépasser maxI, on plafonne à 100
        var disp = v > 0 ? Math.round(r * 100) : '·';
        var cellCol = v > 0 ? tc(r) : 'rgba(122,115,147,0.45)';
        h += '<td style="padding:4px 2px;border-radius:4px;background:' + hc(r) + ';color:' + cellCol + ';font-weight:' + (v > 0 ? '700' : '400') + '">' + disp + '</td>';
      });
    }
    h += noteCell(note);
    h += '<td style="padding:4px 2px">' + gauge(tP, sP, false) + '</td>';
    h += '</tr>';
  });
  h += '</tbody></table></div>';

  var topHtml = '';
  if (top3.length > 0) {
    topHtml = '<div style="margin-top:10px;font-size:12.5px;color:' + PRIMARY + ';font-weight:700">'
      + (isEN ? '🔥 Most activated areas: ' : '🔥 Domaines les plus sollicités : ')
      + top3.map(function (m) { return 'M' + m; }).join(', ') + '</div>';
  }

  var sw = function (bg, txt, extra) { return '<span style="padding:2px 8px;border-radius:4px;background:' + bg + (extra || '') + '">' + txt + '</span>'; };
  var legend = '<div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:12px;font-size:11.5px;color:' + INK_SOFT + ';align-items:center">'
    + '<span>' + (isEN ? 'Legend:' : 'Légende :') + '</span>'
    + sw('#FBF8FF', isEN ? 'Calm' : 'Calme', ';border:1px solid ' + LINE)
    + sw('#EFE3FB', isEN ? 'Low' : 'Faible', ';color:' + PRIMARY)
    + sw('#D9BEF2', isEN ? 'Moderate' : 'Modéré', ';color:' + PRIMARY)
    + sw(SUPPORT, isEN ? 'Strong' : 'Fort', ';color:#fff')
    + sw(PRIMARY, isEN ? 'Intense' : 'Intense', ';color:#fff')
    + '<span style="opacity:.4">|</span>'
    + '<span>' + (isEN ? 'Balance: pink = demanding · purple = supportive' : 'Équilibre : rose = exigeant · violet = porteur') + '</span></div>';

  return '<div style="' + pedagStyle + '">' + pedag + '</div>' + h + topHtml + legend;
}
