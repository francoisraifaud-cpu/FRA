const _ROYAL_SET = new Set(["Aldébaran","Régulus","Antarès","Fomalhaut","Aldebaran","Regulus","Antares"]);
function sanitizeRoyal(t) {
  if (!t) return t;
  return String(t).replace(/([ÉéEe]toile[s]?\s+)[Rr]oyale[s]?(\s+\*{0,3})([A-ZÉÈÀ][\wÀ-ÿ’'’\-]+)/g,
    (m, pre, sp, star) => _ROYAL_SET.has(star) ? m : `${pre.replace(/s\s*$/i, ' ')}fixe${sp}${star}`);
}

