// --- FONCTIONS DE PARSING & NETTOYAGE (reprises À LA LETTRE de la technique THEME) ---
function esc(t) { return String(t).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

function inline(t) {
  const escaped = esc(t);
  return escaped
    .replace(/\*\*\*(.*?)\*\*\*/g, '<strong><em>$1</em></strong>')
    .replace(/\*\*(.*?)\*\*/g, '<strong style="color:var(--primary);font-weight:700;background:rgba(255,166,246,0.18);padding:0 3px;border-radius:3px;">$1</strong>')
    .replace(/\*(.*?)\*/g, '<em>$1</em>');
}

function md(text, ctx) {
  // ctx='maison' : toutes les en-têtes du corps d'une maison sont rendues en TITRE bleu
  // (tk-title, police spéciale) — AUCUN sous-titre rose. ctx='synthese' (défaut) : on
  // conserve la dichotomie titre bleu (##/###) + sous-titre rose (####) du calendrier.
  const houseMode = ctx === 'maison';
  if (!text || (typeof text === 'string' && text.trim() === ''))
    return '<p style="color: #aaa; font-style: italic; font-size: 14px;">' + (isEN ? 'Awaiting generation...' : 'En attente de génération...') + '</p>';
  text = String(text);
  text = sanitizeRoyal(text);
  if (text.includes('\\n')) text = text.replace(/\\n/g, '\n');
  text = text.replace(/^(\s*)\d+[.)]\s+(\*\*)/gm, '$1- $2');
  text = text
    .replace(/^([\*]{0,3}\d[\d.]*[\.\)]\s[^\n]{4,})\n((?!\s*\d+[.)]\s)[^\n\*]{3,80}[\*]{1,3})/gm, '$1 $2');
  text = text.replace(
    /^([\*]{0,3}\d[\d.]*[\.\)]\s[^\n]*\([^\n)]*)\n([\wÀ-ÿ\u2019\u2018'-]+\))/gm,
    '$1 $2');
  text = text.replace(
    /^([\*]{0,3}\d[\d.]*[\.\)]\s[^\n]{30,140})\n([^\n\d\*\#\.]{2,25})\n/gm,
    '$1 $2\n');
  // NB : espaces horizontaux uniquement ([ \t]) — un \s engloberait les \n et
  // dégraderait le titre de la ligne suivante (### …) en texte brut.
  text = text.replace(/^(#{1,3} .+?)[ \t]+#{2,}[ \t]+([^\n]+)$/gm, '$1\n$2');
  // __INTRO_ENFORCE__ (2026-07-05) — garde-fou DÉTERMINISTE : dans le corps d'une MAISON,
  // tout pavé d'introduction porte le titre « ## Introduction » (fin des trous de raquette,
  // quel que soit le comportement du LLM). On ne crée JAMAIS de section vide : on n'agit que
  // s'il existe un vrai pavé d'intro (prose en tête, ou libellé « Introduction » sans titre ##).
  if (houseMode) {
    const _INTRO_H = '## Introduction';
    const _ls = text.split('\n');
    let _fi = 0;
    while (_fi < _ls.length && _ls[_fi].trim() === '') _fi++;
    if (_fi < _ls.length) {
      const _raw = _ls[_fi].trim();
      const _isHead = /^#{1,4}\s/.test(_raw);
      const _label = _raw.replace(/^#{1,4}\s+/, '').replace(/\*/g, '').replace(/\s*:\s*$/, '').trim().toLowerCase();
      const _isIntroLabel = _label === 'introduction' || _label === 'intro';
      if (_isIntroLabel) {
        _ls[_fi] = _INTRO_H;            // normalise « ## Intro », « **Introduction** », « Introduction : » → « ## Introduction »
        text = _ls.join('\n');
      } else if (!_isHead) {
        _ls.splice(_fi, 0, _INTRO_H, ''); // pavé d'intro en prose sans titre → on insère le titre au-dessus
        text = _ls.join('\n');
      }
      // sinon : 1re ligne = titre de section non-intro (ex. « ## Hiver ») → rien (pas de section vide)
    }
  }
  const lines = text.split('\n');
  const out = [];
  let inList = false;

  for (let line of lines) {
    line = line.replace(/^[\uFEFF\u200B]+/, '');
    const isBullet = /^[-*]\s+\S/.test(line) && !/^\*\*/.test(line);
    if (!isBullet && inList) { out.push('</ul>'); inList = false; }
    line = line.replace(/\s+#+\s*$/, '');
    const stripped = line.replace(/\*/g, '');
    let lineHandled = false;

    // --- Normalisation des sous-titres de PÉRIODE (saisons + trimestres, FR/EN) ---
    // Le LLM alterne ## et ### d'une maison à l'autre : on force TOUS ces sous-titres
    // au même niveau (#### → tk-subtitle rose), quel que soit le nombre de #.
    // Les vrais titres de section (Calendrier, titre de maison…) restent en ###/tk-title.
    // NB : pas de \b après les saisons — « Été » finit par un « é » accentué que le
    // \b ASCII ne reconnaît pas comme limite de mot (→ on utilise un lookahead).
    const _periodHead = stripped.match(
      /^#{2,4}\s+((?:Printemps|Été|Ete|Automne|Hiver|Spring|Summer|Autumn|Fall|Winter)(?=\s|:|-|$)|(?:Premier|Première|Premiere|Deuxième|Deuxieme|Troisième|Troisieme|Quatrième|Quatrieme|First|Second|Third|Fourth)\s+(?:Trimestre|Quarter))/i
    );
    if (_periodHead && !houseMode) {
      out.push(`<h5 class="tk-subtitle">${esc(stripped.replace(/^#{2,4}\s+/, ''))}</h5>`);
      continue;
    }

    if (/^#{1,2} /.test(line)) {
      line = '### ' + line.replace(/^#{1,2} /, '').replace(/\*/g, '');
    } else if (/^#{3,} /.test(line)) {
      line = '#### ' + line.replace(/^#{3,} /, '').replace(/\*/g, '');
    } else {
      const subMatch = stripped.match(/^(\d+\.\d+[.)]\s+)(.+)$/);
      if (subMatch) {
        const prefix = subMatch[1];
        const rest   = subMatch[2];
        const colon  = rest.indexOf(' : ');
        if (colon > 0 && colon <= 90) {
          const after = rest.slice(colon + 3);
          if (after.length > 60) {
            out.push(houseMode ? `<h4 class="tk-title"><span class="tk-title-ico">✦</span><span>${esc(prefix + rest.slice(0, colon))}</span></h4>` : `<h5 class="tk-subtitle">${esc(prefix + rest.slice(0, colon))}</h5>`);
            if (after.trim()) out.push(`<p style="font-size: 15.5px; line-height: 1.82; color: #2c2c3a; margin: 4px 0 9px; text-align: justify;">${inline(after)}</p>`);
            lineHandled = true;
          } else if ((prefix + rest).length <= 130) {
            line = '#### ' + prefix + rest;
          }
        } else if ((prefix + rest).length <= 130) {
          line = '#### ' + prefix + rest;
        }
      } else {
        const mainMatch = stripped.match(/^(\d+[.)]\s+)(.+)$/);
        if (mainMatch) {
          const prefix = mainMatch[1];
          const rest   = mainMatch[2];
          if ((prefix + rest).length <= 155) {
            line = '### ' + prefix + rest;
          } else {
            const colon = rest.indexOf(' : ');
            if (colon > 0 && colon <= 120) {
              const after = rest.slice(colon + 3);
              out.push(`<h4 class="tk-title"><span class="tk-title-ico">✦</span><span>${esc(prefix + rest.slice(0, colon))}</span></h4>`);
              if (after.trim()) out.push(`<p style="font-size: 15.5px; line-height: 1.82; color: #2c2c3a; margin: 9px 0; text-align: justify;">${inline(after)}</p>`);
              lineHandled = true;
            } else {
              line = '### ' + prefix + rest;
            }
          }
        } else if (/^\*{2,3}[^*]{4,120}\*{2,3}$/.test(line)) {
          line = '### ' + stripped;
        } else if (/^(conseil|mon\s+conseil|le\s+conseil|advice|conclusion|synthèse|en\s+synthèse|en\s+conclusion|recommandation)\b/i.test(stripped)) {
          // Mot de la fin du synthétiseur (« Conseil central / Conseil de ton
          // astrologue-stratège : … »), émis par le LLM en italique inline sur
          // UNE ligne (label + conseil). On le promeut en titre tk-title + paragraphe,
          // même si la ligne est longue (le split au ' : ' isole le label court).
          const colonIdx = stripped.indexOf(' : ');
          if (colonIdx > 0 && colonIdx <= 60 && stripped.slice(colonIdx + 3).trim().length > 20) {
            out.push(`<h4 class="tk-title"><span class="tk-title-ico">✦</span><span>${esc(stripped.slice(0, colonIdx))}</span></h4>`);
            out.push(`<p style="font-size: 15.5px; line-height: 1.82; color: #2c2c3a; margin: 9px 0; text-align: justify;">${inline(stripped.slice(colonIdx + 3))}</p>`);
            lineHandled = true;
          } else if (stripped.length < 120) {
            line = '### ' + stripped;
          }
        }
      }
    }

    if (lineHandled) continue;

    if (line.startsWith('### ')) {
      out.push(`<h4 class="tk-title"><span class="tk-title-ico">✦</span><span>${esc(line.replace(/^### /, ''))}</span></h4>`);
    } else if (line.startsWith('#### ')) {
      out.push(houseMode ? `<h4 class="tk-title"><span class="tk-title-ico">✦</span><span>${esc(line.replace(/^#### /, ''))}</span></h4>` : `<h5 class="tk-subtitle">${esc(line.replace(/^#### /, ''))}</h5>`);
    } else if (isBullet) {
      if (!inList) { out.push('<ul style="margin: 10px 0 12px 20px; padding: 0;">'); inList = true; }
      out.push(`<li style="font-size: 15.5px; line-height: 1.82; color: #2c2c3a; margin: 7px 0;">${inline(line.replace(/^[-*]\s+/, ''))}</li>`);
    } else if (line.trim() === '') {
      out.push('<div style="height: 10px;"></div>');
    } else if (line.match(/^---+$/) || line.match(/^\*\*\*+$/)) {
      out.push('<hr style="border: 0; border-top: 1px solid #e8ebf5; margin: 22px 0;">');
    } else {
      out.push(`<p style="font-size: 15.5px; line-height: 1.82; color: #2c2c3a; margin: 9px 0; text-align: justify;">${inline(line)}</p>`);
    }
  }
  if (inList) out.push('</ul>');
  return out.join('');
}

