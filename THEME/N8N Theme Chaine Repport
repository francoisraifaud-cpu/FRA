        "jsCode": "const items = $input.all();\n\nlet nomFichierCible = \"Données Techniques Thème Astral\";\ntry {\n  const perso = $('Extract Variables').first().json;\n  const prenom = (perso.prenom || '').trim();\n  const nom = (perso.nom || '').toUpperCase().trim();\n  const nomAffiche = prenom ? `${prenom} ${nom}` : nom;\n  const safeNom = nomAffiche.trim().replace(/[^a-zA-ZÀ-ÿ0-9 \\-]/g, '_');\n  nomFichierCible = `Données Techniques Thème Astral - ${safeNom}`;\n} catch(e) {}\n\nfor (const item of items) {\n  if (!item.binary) continue;\n\n  // 1. On cible spécifiquement le vrai fichier PDF renvoyé par Gotenberg (sous la clé 'data')\n  if (item.binary.data) {\n    item.binary.data.fileName = `${nomFichierCible}.pdf`;\n    item.binary.data.mimeType = 'application/pdf';\n    item.binary.data.fileExtension = 'pdf';\n  }\n\n  // 2. On supprime le fichier HTML d'origine pour ne garder QUE le PDF et éviter les doublons\n  if (item.binary.html_file) {\n    delete item.binary.html_file;\n  }\n}\n\nreturn items;"
